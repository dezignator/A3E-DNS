# ============================================================
# A3E-DNS — .gitignore
# Thesis artifact (Chapter 6)
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---------- Virtual environments ----------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# ---------- Testing / coverage ----------
.pytest_cache/
.cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
coverage.xml
*.cover

# ---------- Type checkers / linters ----------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
.pylint.d/

# ---------- Jupyter ----------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.nbconvert.ipynb
profile_default/
ipython_config.py

# ---------- Build / packaging ----------
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
.eggs/
pyproject.toml.bak
setup.cfg.bak

# ---------- Datasets (raw / large) ----------
# Never commit raw datasets. Toy + synthetic fixtures ARE committed.
data/raw/
data/zenodo/
data/doh_realworld/
data/kosekmi_doq/
data/*.zip
data/*.tar
data/*.tar.gz
data/*.tgz
data/*.7z
data/downloads/
data/cache/
!data/synthetic/
!data/threat_feeds/
!data/attack_matrix.json
!data/attack_taxonomy.json
!data/compliance_mapping.json

# ---------- Large binary artifacts ----------
*.npz
*.npy
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.parquet
*.feather
*.arrow
*.zarr
*.pcap
*.pcapng
*.cap
*.bin
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.pb
*.tflite
*.msgpack

# ---------- Model checkpoints / logs ----------
checkpoints/
runs/
logs/
*.log
wandb/
mlruns/
lightning_logs/
tensorboard/
events.out.tfevents.*

# ---------- Expected outputs: commit JSON/SVG/PNG only ----------
# (Binaries inside expected_outputs/ are *intended* to be committed as
#  small reference artifacts; do not ignore them globally.)
!expected_outputs/*.json
!expected_outputs/*.svg
!expected_outputs/*.png
!expected_outputs/MANIFEST.sha256

# ---------- Outputs that must never be committed ----------
outputs/
results/
artifacts/
reports/
tmp/
temp/
.scratch/
*.tmp
*.bak
*.swp
*.swo
*~

# ---------- Environment / secrets ----------
.env
.env.*
!.env.example
*.key
*.pem
*.crt
*.p12
*.pfx
secrets/
.secrets/
*.secret

# ---------- Docker / Kubernetes local overrides ----------
.docker/
.kube/
minikube/
*.dockerignore.bak
docker-compose.override.yml

# ---------- P4 / eBPF build artifacts ----------
*.o
*.bpf.o
*.ll
p4_build/
bmv2/
*.json.p4i
target/

# ---------- Dask / distributed ----------
dask-worker-space/
*.dask/
.dask/

# ---------- macOS / Windows / Linux ----------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.directory
.Trash-*

# ---------- Editors / IDEs ----------
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ---------- LaTeX (thesis builds) ----------
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.synctex.gz
*.toc
*.xdv
thesis_build/
